rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /payrollData/{userId}/{collectionName}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionName in ['employees', 'payRuns', 'employeeHistory', 'settings'];
    }
  }
}
